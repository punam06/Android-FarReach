{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FarReach Flutter (Debug)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
      ]
    },
    {
      "name": "FarReach Android Emulator",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "toolArgs": [
        "--enable-software-rendering",
        "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
      ]
    }
  ]
}
