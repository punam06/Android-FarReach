{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Start Tourism Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true,
      "serverReadyAction": {
        "pattern": "API server listening on http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "FarReach Android (local API)",
      "request": "launch",
      "type": "dart",
      "cwd": "mobile",
      "toolArgs": [
        "--dart-define",
        "API_BASE_URL=http://10.0.2.2:3000"
      ]
    }
  ]
}
