# Copy this file to .env and replace the placeholder values.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=torisom_db

OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
# Optional server-side Gemini travel assistant. Never put this key in the Flutter app.
GEMINI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASS=YOUR_SMTP_APP_PASSWORD_HERE
SMTP_FROM=Bangladesh Tourism <your-email@example.com>
PORT=3000
APP_API_BASE_URL=http://127.0.0.1:3000
# Production: set an HTTPS API URL, exact comma-separated HTTPS web origins,
# configured SMTP, and a dedicated DB user with a strong non-development password.
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
DB_SSL=false
DB_SSL_CA_FILE=

