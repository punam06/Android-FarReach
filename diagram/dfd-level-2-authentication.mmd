%% FarReach Tourism App - DFD Level 2 for Authentication
flowchart LR
    classDef external fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#7c2d12
    classDef process fill:#ecfeff,stroke:#0891b2,stroke-width:2px,color:#164e63
    classDef store fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#0f172a

    User[Traveler / User]
    EmailService[Email Service]

    A1((1.1 Start Signup))
    A2((1.2 Generate and Send OTP))
    A3((1.3 Verify OTP))
    A4((1.4 Set Password))
    A5((1.5 Login and Create Session))
    A6((1.6 Update Profile))

    U[(Users)]
    O[(OTP Verifications)]
    L[(OTP Attempt Limits)]

    User -->|name and email| A1
    A1 -->|check existing email| U
    A1 -->|signup request accepted| A2

    A2 -->|hashed OTP and expiry| O
    A2 -->|email OTP| EmailService
    EmailService -->|delivery status| A2
    A2 -->|ask user to verify| User

    User -->|email and OTP| A3
    A3 <--> O
    A3 <--> L
    A3 -->|verified email| A4

    User -->|password| A4
    A4 -->|new verified account| U
    A4 -->|account created| User

    User -->|email and password| A5
    A5 -->|validate credentials| U
    A5 -->|session token and role| User

    User -->|profile details and picture| A6
    A6 -->|updated profile| U
    A6 -->|profile saved| User

    class User,EmailService external
    class A1,A2,A3,A4,A5,A6 process
    class U,O,L store
