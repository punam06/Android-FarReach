%% FarReach Tourism App - DFD Level 0 / Context Diagram
flowchart LR
    classDef external fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#7c2d12
    classDef process fill:#ecfeff,stroke:#0891b2,stroke-width:2px,color:#164e63
    classDef store fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#0f172a

    Traveler[Traveler / User]
    Admin[Admin]
    WeatherAPI[Weather API]
    EmailService[Email Service]
    App((FarReach Tourism App))
    DB[(Tourism Database)]

    Traveler -->|search, signup, booking, review| App
    App -->|spots, dashboard, booking status| Traveler

    Admin -->|manage spots, users, bookings| App
    App -->|stats and management data| Admin

    App -->|read and write records| DB
    DB -->|stored tourism data| App

    App -->|district and date| WeatherAPI
    WeatherAPI -->|weather and forecast| App

    App -->|OTP email request| EmailService
    EmailService -->|OTP delivery result| App

    class Traveler,Admin,WeatherAPI,EmailService external
    class App process
    class DB store
